{
  "name": "student-helper-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android app for Student Helper. It is the same website (../public) packed into an app with Capacitor, talking to the online API.",
  "scripts": {
    "build:web": "node build-web.js",
    "sync": "npm run build:web && npx cap sync android",
    "icons": "npx @capacitor/assets@3.0.5 generate --android --iconBackgroundColor \"#4f7a6a\" --splashBackgroundColor \"#f5f2ec\" --splashBackgroundColorDark \"#1d2421\"",
    "open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  },
  "engines": {
    "node": ">=22"
  }
}
