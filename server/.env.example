# =============================================================
#  Student Helper - settings
#  Copy this file to ".env" and fill in your own values.
#  NEVER share your real .env file (it has your secret keys).
# =============================================================

# Port the website + API runs on  ->  http://localhost:3000
PORT=3000

# Time zone used for "today", check-ins and streaks
APP_TIMEZONE=Asia/Dhaka

# ---- Database: EITHER one link (cloud, e.g. TiDB Cloud) ... ----
# DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/student_helper
# DB_SSL=true

# ---- ... OR your local MySQL login (the same one you use in MySQL Workbench / XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_helper

# Secret used to sign login tokens. Use any long random text.
JWT_SECRET=change-me-to-a-long-random-string

# Key used to ENCRYPT chat messages in the database.
# Must be 64 hex characters (32 bytes). Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do not change it later, or old messages can no longer be read.
CHAT_SECRET_KEY=

# Minutes a student has to check in after a task starts (10-15 is the idea)
CHECKIN_WINDOW_MINUTES=15

# A day counts towards the streak when the student earns at least this many points (out of 100)
STREAK_MIN_POINTS=70
